# Copy to .env (never commit .env). Every value here is a placeholder.
JWT_SECRET=replace-with-a-long-random-string
DEBUG=false
TWIN_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/bookstore.db

SEED=42
# Comma-separated list
CORS_ORIGINS=http://localhost:3000

# Switch on the deliberately vulnerable code paths (lab scenarios only)
DEBUG_SQLI_MODE=false
DEBUG_PRICE_MODE=false
DEBUG_ACCESS_MODE=false
